{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-autopilot/contracts.schema.json",
  "title": "Codex Autopilot V1 contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "revision", "updated_at", "skill_version", "policy_version", "repository", "owner", "lifecycle"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 0},
    "previous_publication_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "updated_at": {"type": "string", "minLength": 20},
    "skill_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "repository": {"$ref": "#/$defs/repository"},
    "owner": {"$ref": "#/$defs/owner"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "run_settings": {"$ref": "#/$defs/run_settings"},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "intent": {"$ref": "#/$defs/intent"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
    "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "tickets": {"type": "array", "items": {"$ref": "#/$defs/ticket"}},
    "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "invalidations": {"type": "array", "items": {"$ref": "#/$defs/invalidation"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "acceptance": {"type": "array", "items": {"$ref": "#/$defs/acceptance"}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "usage": {"$ref": "#/$defs/usage"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"type": "string", "enum": ["PREFLIGHT", "INTENT", "DESIGN", "PLAN", "EXECUTE", "VERIFY", "ACCEPT"]},
    "control": {"type": "string", "enum": ["ACTIVE", "QUIESCING", "PAUSED", "BLOCKED", "RECOVERING", "ACCEPTED", "FAILED", "CANCELLED"]},
    "ticket_state": {"type": "string", "enum": ["PLANNED", "READY", "RUNNING", "CANDIDATE", "REVIEW", "INTEGRATED", "BLOCKED", "REPAIR", "STALE", "CANCELLED"]},
    "attempt_state": {"type": "string", "enum": ["PREPARED", "DISPATCHED", "RETURNED", "LOST", "INTERRUPTED"]},
    "cause": {"type": "string", "enum": ["implementation", "contract", "oracle", "environment", "permission", "ownership", "orchestration", "user_intent", "unknown"]},
    "risk": {"type": "string", "enum": ["routine", "elevated", "critical"]},
    "complexity": {"type": "string", "enum": ["bounded", "coupled", "ambiguous"]},
    "verdict": {"type": "string", "enum": ["PASS", "BLOCK", "UNVERIFIABLE"]},
    "outcome": {"type": "string", "enum": ["pass", "fail", "not_run", "unverifiable"]},
    "document": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "path", "hash", "kind"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string"}, "path": {"type": "string"}, "hash": {"$ref": "#/$defs/hash"}, "kind": {"type": "string"}, "section_anchors": {"type": "array", "items": {"type": "string"}}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["control_root", "execution_root", "common_dir", "initial_head", "branch"],
      "properties": {"control_root": {"type": "string"}, "execution_root": {"type": "string"}, "common_dir": {"type": "string"}, "initial_head": {"type": ["string", "null"]}, "branch": {"type": "string"}, "checkout": {"type": "string"}, "inventory_ref": {"type": ["string", "null"]}, "instruction_refs": {"type": "array", "items": {"type": "string"}}}
    },
    "owner": {
      "type": "object", "additionalProperties": false, "required": ["token", "epoch", "observed_session"],
      "properties": {"token": {"type": "string", "minLength": 1}, "epoch": {"type": "integer", "minimum": 0}, "observed_session": {"type": ["string", "null"]}, "handoff_ref": {"type": ["string", "null"]}, "attestation_ref": {"type": ["string", "null"]}}
    },
    "run_settings": {
      "type": "object", "additionalProperties": false, "required": ["interaction_mode", "depth"],
      "properties": {
        "interaction_mode": {"type": "string", "enum": ["semi", "full"]},
        "depth": {"type": "string", "enum": ["normal", "deep"]}
      }
    },
    "next_action": {
      "type": "object", "additionalProperties": false, "required": ["kind", "subject_refs", "preconditions", "read_refs"],
      "properties": {"kind": {"type": "string"}, "subject_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "preconditions": {"type": "array", "items": {"type": "string"}}, "read_refs": {"type": "array", "items": {"type": "string"}}}
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["phase", "control", "next_action"],
      "properties": {"phase": {"$ref": "#/$defs/phase"}, "control": {"$ref": "#/$defs/control"}, "reason": {"type": ["string", "null"]}, "issue_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "stop_target": {"type": ["string", "null"]}, "next_action": {"$ref": "#/$defs/next_action"}}
    },
    "intent": {
      "type": "object", "additionalProperties": false, "required": ["current_revision", "document_ref", "approved_amendments"],
      "properties": {"current_revision": {"type": "string"}, "document_ref": {"$ref": "#/$defs/id"}, "document_hash": {"$ref": "#/$defs/hash"}, "approved_amendments": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "acceptance_policy": {"type": "string"}, "checkpoint_policy": {"type": "string"}, "prior_accepted_refs": {"type": "array", "items": {"type": "string"}}}
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "status", "provenance_refs", "criterion_refs"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string"}, "status": {"type": "string", "enum": ["active", "deferred", "dropped", "superseded"]}, "provenance_refs": {"type": "array", "items": {"type": "string"}}, "criterion_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "decision_ref": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "requirement_refs", "oracle", "status"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string"}, "requirement_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "oracle": {"type": "string"}, "status": {"type": "string", "enum": ["active", "deferred", "dropped", "superseded"]}, "source_ref": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}
    },
    "contract": {"type": "object", "additionalProperties": false, "required": ["id", "version", "status", "provenance_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string"}, "status": {"type": "string"}, "provenance_refs": {"type": "array", "items": {"type": "string"}}, "producer_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "consumer_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "type", "status", "decision", "reason", "evidence_refs", "affected_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"type": "string"}, "status": {"type": "string"}, "decision": {"type": "string"}, "reason": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "affected_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "introduced_revision": {"type": "string"}, "supersedes": {"type": "array", "items": {"type": "string"}}, "intent_revision": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "zone_entry": {"type": "object", "additionalProperties": false, "required": ["path", "operations"], "properties": {"path": {"type": "string"}, "operations": {"type": "array", "items": {"type": "string", "enum": ["create", "modify", "delete", "rename"]}}}},
    "ticket": {
      "type": "object", "additionalProperties": false, "required": ["id", "goal_ref", "criterion_refs", "dependency_refs", "state", "complexity", "risk", "zone"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "goal_ref": {"$ref": "#/$defs/id"}, "criterion_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "contract_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "dependency_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "state": {"$ref": "#/$defs/ticket_state"}, "verification_ref": {"type": ["string", "null"]}, "complexity": {"$ref": "#/$defs/complexity"}, "risk": {"$ref": "#/$defs/risk"}, "zone": {"type": "array", "items": {"$ref": "#/$defs/zone_entry"}}, "current_attempt": {"type": ["string", "null"]}, "replacement_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "intent_revision": {"type": ["string", "null"]}, "intent_document_ref": {"type": ["string", "null"]}, "intent_document_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}
    },
    "lease": {"type": "object", "additionalProperties": false, "required": ["id", "state", "zone"], "properties": {"id": {"$ref": "#/$defs/id"}, "state": {"type": "string", "enum": ["active", "quarantined", "released"]}, "zone": {"type": "array", "items": {"$ref": "#/$defs/zone_entry"}}}},
    "attempt": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "mode", "subject_ref", "packet_ref", "packet_hash", "epoch", "state", "lease"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "mode": {"type": "string"}, "subject_ref": {"$ref": "#/$defs/id"}, "packet_ref": {"type": ["string", "null"]}, "packet_hash": {"type": ["string", "null"]}, "epoch": {"type": "integer", "minimum": 0}, "state": {"$ref": "#/$defs/attempt_state"}, "lease": {"$ref": "#/$defs/lease"}, "route_ref": {"type": ["string", "null"]}, "checkout": {"type": ["string", "null"]}, "base_sha": {"type": ["string", "null"]}, "candidate_sha": {"type": ["string", "null"]}, "candidate_tree_sha": {"type": ["string", "null"]}, "return_ref": {"type": ["string", "null"]}, "finding_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "handoff": {"type": ["object", "null"]}, "failure_signature": {"type": ["string", "null"]}, "repair_contract": {"$ref": "#/$defs/repair_contract"}, "intent_revision": {"type": ["string", "null"]}, "intent_document_ref": {"type": ["string", "null"]}, "intent_document_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}
    },
    "issue": {"type": "object", "additionalProperties": false, "required": ["id", "type", "cause", "impact", "affected_refs", "disposition"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"type": "string"}, "cause": {"$ref": "#/$defs/cause"}, "impact": {"type": "string", "enum": ["blocking", "advisory"]}, "affected_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "expected": {"type": ["string", "null"]}, "actual": {"type": ["string", "null"]}, "disposition": {"type": "string"}, "resolution_condition": {"type": ["string", "null"]}, "owner": {"type": ["string", "null"]}, "failure_signature": {"type": ["string", "null"]}, "finding_ref": {"type": ["string", "null"]}, "source_ref": {"type": ["string", "null"]}, "intent_revision": {"type": ["string", "null"]}, "decision_ref": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["id", "axis", "impact", "claim", "expected", "actual", "evidence", "affected_refs", "source_ref"], "properties": {"id": {"$ref": "#/$defs/id"}, "axis": {"type": "string", "minLength": 1}, "impact": {"type": "string", "enum": ["blocking", "advisory"]}, "claim": {"type": "string", "minLength": 1}, "expected": {"type": "string"}, "actual": {"type": "string"}, "evidence": {"type": "string", "minLength": 1}, "affected_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "source_ref": {"$ref": "#/$defs/id"}, "intent_revision": {"type": ["string", "null"]}, "repair_contract_ref": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "invalidation": {"type": "object", "additionalProperties": false, "required": ["id", "amendment_ref", "intent_revision", "previous_intent_revision", "previous_document_ref", "previous_document_hash", "affected_refs", "consumer_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "amendment_ref": {"$ref": "#/$defs/id"}, "intent_revision": {"type": "string"}, "previous_intent_revision": {"type": ["string", "null"]}, "previous_document_ref": {"$ref": "#/$defs/id"}, "previous_document_hash": {"$ref": "#/$defs/hash"}, "affected_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "consumer_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "recorded_at": {"type": "string"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["id", "mandate", "subject_fingerprint", "verdict", "return_ref"], "properties": {"id": {"$ref": "#/$defs/id"}, "mandate": {"type": "string"}, "subject_fingerprint": {"type": "string"}, "verdict": {"$ref": "#/$defs/verdict"}, "return_ref": {"type": "string"}, "context_refs": {"type": "array", "items": {"type": "string"}}, "finding_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "intent_revision": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["round", "intent_revision", "candidate_fingerprint", "verdict", "transport"], "properties": {"round": {"type": "integer", "minimum": 1}, "intent_revision": {"type": "string"}, "candidate_fingerprint": {"type": "string"}, "verdict": {"$ref": "#/$defs/verdict"}, "transport": {"type": "string", "enum": ["automatic", "user_assisted"]}, "context_grade": {"type": "string"}, "setup_receipt_ref": {"type": ["string", "null"]}, "context_receipt_ref": {"type": ["string", "null"]}, "return_ref": {"type": ["string", "null"]}, "outcome_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "target", "state"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "target": {"type": "string"}, "state": {"type": "string", "enum": ["prepared", "applied", "abandoned", "uncertain"]}, "expected_before": {"type": ["string", "null"]}, "intended_after": {"type": ["string", "null"]}, "authority_ref": {"type": ["string", "null"]}, "receipt_ref": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["key", "knowledge", "evidence_ref", "scope", "fingerprint"], "properties": {"key": {"type": "string"}, "value": {}, "knowledge": {"type": "string", "enum": ["CONFIRMED", "REJECTED", "UNKNOWN"]}, "evidence_ref": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"]}, "scope": {"type": "string"}, "fingerprint": {"type": "string"}, "invalidated_by": {"type": "array", "items": {"type": "string"}}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "capability", "reasoning", "adequacy", "context_grade"], "properties": {"id": {"$ref": "#/$defs/id"}, "capability": {"type": "string"}, "reasoning": {"type": "string"}, "requested_binding": {"type": ["string", "null"]}, "observed_binding": {"type": ["string", "null"]}, "adequacy": {"type": "string", "enum": ["CONFIRMED", "UNKNOWN", "REJECTED"]}, "context_grade": {"type": "string"}, "fallback_cause": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "hash", "source", "outcome", "observer"], "properties": {"id": {"$ref": "#/$defs/id"}, "hash": {"$ref": "#/$defs/hash"}, "source": {"type": "string"}, "scenario": {"type": ["string", "null"]}, "outcome": {"type": "string"}, "observer": {"type": "string"}, "subject": {"type": ["string", "null"]}, "invalidated_by": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "usage_counter": {"type": "object", "additionalProperties": false, "properties": {"helper_calls": {"type": "integer", "minimum": 0}, "model_turns": {"type": "integer", "minimum": 0}, "orchestrator_turns": {"type": "integer", "minimum": 0}, "spawn_calls": {"type": "integer", "minimum": 0}, "wait_calls": {"type": "integer", "minimum": 0}, "git_calls": {"type": "integer", "minimum": 0}, "internal_publications": {"type": "integer", "minimum": 0}, "packet_bytes": {"type": "integer", "minimum": 0}, "return_bytes": {"type": "integer", "minimum": 0}, "brief_bytes": {"type": "integer", "minimum": 0}, "wall_time_ms": {"type": "integer", "minimum": 0}, "approvals": {"type": "integer", "minimum": 0}, "user_interventions": {"type": "integer", "minimum": 0}, "manual_handoffs": {"type": "integer", "minimum": 0}, "manual_setup": {"type": "integer", "minimum": 0}, "manual_wait": {"type": "integer", "minimum": 0}}},
    "usage_trace": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "actor", "subject_ref", "delta"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "actor": {"type": "string"}, "subject_ref": {"type": ["string", "null"]}, "delta": {"$ref": "#/$defs/usage_counter"}, "evidence_ref": {"type": ["string", "null"]}, "recorded_at": {"type": "string"}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["counters", "tokens", "token_reason", "trace", "shared_setup", "gate_costs"], "properties": {"counters": {"$ref": "#/$defs/usage_counter"}, "tokens": {"type": ["integer", "null"], "minimum": 0}, "token_reason": {"type": ["string", "null"]}, "unknown_reason": {"type": ["string", "null"]}, "trace": {"type": "array", "items": {"$ref": "#/$defs/usage_trace"}}, "shared_setup": {"$ref": "#/$defs/usage_counter"}, "gate_costs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/usage_counter"}}}},
    "usage_event": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "actor", "subject_ref", "delta"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "subject_ref": {"type": ["string", "null"]}, "delta": {"$ref": "#/$defs/usage_counter"}, "tokens": {"type": ["integer", "null"], "minimum": 0}, "token_reason": {"type": ["string", "null"]}, "scope": {"type": "string", "enum": ["run", "shared_setup", "G0", "G1", "G2", "G3", "G4", "G5", "G6"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/usage_evidence"}}}},
    "usage_evidence": {"type": "object", "additionalProperties": false, "required": ["id", "hash", "outcome", "observer"], "properties": {"id": {"$ref": "#/$defs/id"}, "hash": {"$ref": "#/$defs/hash"}, "outcome": {"type": "string"}, "observer": {"type": "string"}, "scenario": {"type": ["string", "null"]}}},
    "packet_identity": {"type": "object", "additionalProperties": false, "required": ["run_id", "attempt_id"], "properties": {"run_id": {"$ref": "#/$defs/id"}, "ticket_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "packet_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "epoch": {"type": "integer", "minimum": 0}, "source_revision": {"type": "integer", "minimum": 0}, "intent_revision": {"type": ["string", "null"]}, "intent_document_ref": {"type": ["string", "null"]}, "intent_document_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "contract_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "worker_acceptance": {"type": "object", "additionalProperties": false, "required": ["criterion_id"], "properties": {"criterion_id": {"$ref": "#/$defs/id"}, "done_when": {"type": "string"}, "expected": {"type": "string"}}},
    "worker_workspace": {"type": "object", "additionalProperties": false, "required": ["root", "expected_base"], "properties": {"root": {"type": "string"}, "expected_base": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"}, "clean_required": {"type": "boolean"}}},
    "write_allow": {"type": "object", "additionalProperties": false, "required": ["path", "operations"], "properties": {"path": {"type": "string"}, "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["create", "modify", "delete", "rename"]}}}},
    "worker_write": {"type": "object", "additionalProperties": false, "required": ["allow"], "properties": {"allow": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/write_allow"}}, "deny": {"type": "array", "items": {"type": "string"}}}},
    "worker_check": {"type": "object", "additionalProperties": false, "required": ["check_id"], "properties": {"check_id": {"$ref": "#/$defs/id"}, "command": {"type": "string"}, "scenario": {"type": "string"}, "expected": {"type": "string"}, "criterion_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "required": {"type": "boolean"}}},
    "worker_risk": {"type": "object", "additionalProperties": false, "required": ["level"], "properties": {"level": {"$ref": "#/$defs/risk"}, "axes": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}},
    "context_pointer": {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"type": "string"}, "slice": {"type": "string"}, "version": {"type": "string"}, "hash": {"$ref": "#/$defs/hash"}}},
